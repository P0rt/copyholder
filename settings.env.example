# Optional, non-secret settings. Copy to settings.env (ignored by git).
# One KEY=value per line; host and tap read it the same way. A ` # note` after a value is not part of it:
# quote a value that holds one, e.g. COPYHOLDER_CAMERA_NAME="Desk Cam # 2". The environment wins over this file.
# Exact camera name as printed by `npm run smoke`; needed only with several cameras.
COPYHOLDER_CAMERA_NAME=
# Set to `spare` to switch to the spare metric set; empty by default.
COPYHOLDER_METRICS=
# Part of the microphone's name, any case, e.g. External Microphone for a 3.5 mm headset on a MacBook; empty: the system default.
COPYHOLDER_MIC_NAME=
# Part of the output device's name, any case, e.g. External Headphones; empty: the system default.
COPYHOLDER_OUTPUT_NAME=
# Port of the local page on 127.0.0.1; empty: 47811. Keep it fixed so Chrome remembers the microphone permission.
COPYHOLDER_PORT=
# Demo takes show the face preview (spec 15.5); set to `off` to take it out.
COPYHOLDER_FACE_PREVIEW=
